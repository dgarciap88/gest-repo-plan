{
  "schema_version": 1,
  "name": "implement-task",
  "description": "Implementa una tarea de tasks/ en un workspace, la valida con tests y un validador cruzado y abre un PR tras la aprobación manual",
  "inputs": {
    "task_id": { "type": "string", "required": true, "pattern": "^TASK-\\d+$", "description": "Id de la tarea (fichero tasks/<id>.md del repo)" },
    "repo_url": { "type": "string", "required": true, "description": "URL del repositorio" },
    "base": { "type": "string", "default": "main", "description": "Rama base" }
  },
  "settings": { "max_agents_parallel": 2, "language": "es", "display_inputs": ["task_id"] },
  "nodes": {
    "ws": {
      "type": "prepare_workspace",
      "config": {
        "repo_url": "${inputs.repo_url}",
        "base_branch": "${inputs.base}",
        "new_branch": "feature/${inputs.task_id}"
      }
    },
    "dev": {
      "type": "ia_agent",
      "max_attempts": 5,
      "config": {
        "provider": "claude",
        "model_tier": "cheap",
        "workspace": "${nodes.ws.outputs.path}",
        "prompt_template": "templates/prompts/implement-task.md",
        "variables": {
          "task_path": "tasks/${inputs.task_id}.md",
          "feedback": "${nodes.val.outputs.feedback}"
        },
        "max_cost_usd": 1.0
      }
    },
    "tests": {
      "type": "run_command",
      "config": {
        "workspace": "${nodes.ws.outputs.path}",
        "command": ["python", "-m", "pytest", "-q"]
      }
    },
    "val": {
      "type": "ia_agent_validator",
      "config": {
        "provider": "claude",
        "model_tier": "cheap",
        "workspace": "${nodes.ws.outputs.path}",
        "prompt_template": "templates/prompts/validate-task.md",
        "variables": { "task_path": "tasks/${inputs.task_id}.md" },
        "max_retries": 2,
        "max_cost_usd": 0.5
      }
    },
    "commit": {
      "type": "git.commit",
      "config": {
        "workspace": "${nodes.ws.outputs.path}",
        "subject": "${nodes.dev.outputs.suggested_commit_subject}",
        "body": "${nodes.dev.outputs.suggested_commit_body}"
      }
    },
    "approval": {
      "type": "manual_approval",
      "config": {
        "approves": ["push", "pr"],
        "message": "Revisa el diff, el mensaje de commit y el PR antes de publicar"
      }
    },
    "push": {
      "type": "git.push",
      "config": {
        "workspace": "${nodes.ws.outputs.path}",
        "remote_branch": "${nodes.ws.outputs.remote_branch}"
      }
    },
    "pr": {
      "type": "git.create_pr",
      "config": {
        "workspace": "${nodes.ws.outputs.path}",
        "base_branch": "${inputs.base}",
        "head_branch": "${nodes.ws.outputs.remote_branch}",
        "title": "${nodes.dev.outputs.suggested_pr_title}",
        "body": "${nodes.dev.outputs.suggested_pr_body}"
      }
    }
  },
  "edges": [
    { "from": "ws.ok", "to": "dev" },
    { "from": "dev.done", "to": "tests" },
    { "from": "tests.ok", "to": "val" },
    { "from": "tests.failed", "to": "dev" },
    { "from": "val.changes_requested", "to": "dev" },
    { "from": "val.approved", "to": "commit" },
    { "from": "val.max_retries_reached", "to": "commit" },
    { "from": "val.no_progress", "to": "commit" },
    { "from": "commit.ok", "to": "approval" },
    { "from": "approval.approved", "to": "push" },
    { "from": "push.ok", "to": "pr" }
  ]
}
