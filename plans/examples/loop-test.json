{
  "schema_version": 1,
  "name": "loop-test",
  "description": "Implementa una tarea de tasks/ en un workspace, la valida con tests y un validador cruzado y abre un PR tras la aprobación manual",
  "inputs": {
    "task_id": {
      "type": "string",
      "required": true,
      "pattern": "^TASK-\\d+$",
      "description": "Id de la tarea (fichero tasks/<id>.md del repo)"
    },
    "repo_url": {
      "type": "string",
      "required": true,
      "description": "URL del repositorio"
    },
    "base": {
      "type": "string",
      "default": "main",
      "description": "Rama base"
    }
  },
  "settings": {
    "max_agents_parallel": 2,
    "language": "es",
    "display_inputs": [
      "task_id"
    ]
  },
  "nodes": {
    "ws": {
      "type": "prepare_workspace",
      "config": {
        "repo_url": "${inputs.repo_url}",
        "base_branch": "${inputs.base}",
        "new_branch": "feature/${inputs.task_id}"
      }
    },
    "dev": {
      "type": "ia_agent",
      "max_attempts": 5,
      "config": {
        "provider": "claude",
        "model_tier": "cheap",
        "workspace": "${nodes.ws.outputs.path}",
        "prompt_template": "templates/prompts/implement-task.md",
        "variables": {
          "task_path": "tasks/TASK-902-dev.md",
          "feedback": "${nodes.val.outputs.feedback}"
        },
        "max_cost_usd": 1.0
      }
    },
    "tests": {
      "type": "run_command",
      "config": {
        "workspace": "${nodes.ws.outputs.path}",
        "command": [
          "python",
          "-m",
          "pytest",
          "-q"
        ]
      }
    },
    "val": {
      "type": "ia_agent_validator",
      "config": {
        "provider": "claude",
        "model_tier": "cheap",
        "workspace": "${nodes.ws.outputs.path}",
        "prompt_template": "templates/prompts/validate-task.md",
        "variables": {
          "task_path": "tasks/TASK-902-full.md"
        },
        "max_retries": 2,
        "max_cost_usd": 0.5
      }
    },
    "scan": {
      "type": "secret_scan",
      "config": {
        "workspace": "${nodes.ws.outputs.path}"
      }
    },
    "triage": {
      "type": "secret_triage",
      "config": {
        "workspace": "${nodes.ws.outputs.path}",
        "findings": "${nodes.scan.outputs.findings}",
        "model_tier": "cheap",
        "max_cost_usd": 0.2
      }
    },
    "commit": {
      "type": "git.commit",
      "join": "any",
      "config": {
        "workspace": "${nodes.ws.outputs.path}",
        "subject": "${nodes.dev.outputs.suggested_commit_subject}",
        "body": "${nodes.dev.outputs.suggested_commit_body}"
      }
    },
    "approval": {
      "type": "manual_approval",
      "config": {
        "approves": [
          "push",
          "pr"
        ],
        "message": "Revisa el diff, el mensaje de commit y el PR antes de publicar"
      }
    },
    "push": {
      "type": "git.push",
      "config": {
        "workspace": "${nodes.ws.outputs.path}",
        "remote_branch": "${nodes.ws.outputs.remote_branch}"
      }
    },
    "pr": {
      "type": "git.create_pr",
      "config": {
        "workspace": "${nodes.ws.outputs.path}",
        "base_branch": "${inputs.base}",
        "head_branch": "${nodes.ws.outputs.remote_branch}",
        "title": "${nodes.dev.outputs.suggested_pr_title}",
        "body": "${nodes.dev.outputs.suggested_pr_body}"
      }
    },
    "checks": {
      "type": "github.wait_checks",
      "config": {
        "workspace": "${nodes.ws.outputs.path}",
        "pr": "${nodes.pr.outputs.pr_url}",
        "max_wait_s": 1800
      }
    }
  },
  "edges": [
    {
      "from": "ws.ok",
      "to": "dev"
    },
    {
      "from": "dev.done",
      "to": "tests"
    },
    {
      "from": "tests.ok",
      "to": "val"
    },
    {
      "from": "tests.failed",
      "to": "dev"
    },
    {
      "from": "val.changes_requested",
      "to": "dev"
    },
    {
      "from": "val.approved",
      "to": "scan"
    },
    {
      "from": "val.max_retries_reached",
      "to": "scan"
    },
    {
      "from": "val.no_progress",
      "to": "scan"
    },
    {
      "from": "scan.clean",
      "to": "commit"
    },
    {
      "from": "scan.secrets_detected",
      "to": "triage"
    },
    {
      "from": "triage.all_false_positive",
      "to": "commit"
    },
    {
      "from": "commit.ok",
      "to": "approval"
    },
    {
      "from": "approval.approved",
      "to": "push"
    },
    {
      "from": "push.ok",
      "to": "pr"
    },
    {
      "from": "pr.ok",
      "to": "checks"
    }
  ]
}