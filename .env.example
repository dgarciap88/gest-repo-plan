# Copia este fichero a .env (está en .gitignore) y rellénalo. Nunca subas credenciales al repositorio.

# Atlassian Cloud (nodos jira.* y confluence.*). El token se crea en https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://tuempresa.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Opcionales: por defecto se reutilizan las credenciales y la URL de Jira (+ /wiki)
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Servidor web: token opcional para la API local
GP_API_TOKEN=

# Proveedor Copilot (sin valores por defecto): modelos por nivel de coste
GP_COPILOT_MODEL_CHEAP=
GP_COPILOT_MODEL_STANDARD=
GP_COPILOT_MODEL_PREMIUM=

# Carpeta con los agentes y skills de usuario (<home>/.copilot por defecto): agents/<nombre>.agent.md y skills/<nombre>/SKILL.md
GP_AGENTS_HOME=

# Rutas y límites
GP_DATA_DIR=data
GP_MAX_CONCURRENT_NODES=4
GP_MAX_AGENTS_PARALLEL=2
